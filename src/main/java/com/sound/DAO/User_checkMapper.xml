<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sound.DAO.User_checkMapper">

	<!-- 사용자 응답을 삽입하는 쿼리 -->
	<insert id="insertUserCheck"
		parameterType="com.sound.entity.User_check">
		INSERT INTO user_check (
		check_id,
		list_ident,
		item_response,
		usr_id)
		VALUES (
		#{checkId},
		#{listIdent},
		#{itemResponse},
		#{usrId})
	</insert>

	<!-- check_id의 최대값을 가져오는 쿼리 -->
	<select id="getMaxCheckId" resultType="int">
		SELECT COALESCE(MAX(check_id), 0) FROM user_check
	</select>




</mapper>