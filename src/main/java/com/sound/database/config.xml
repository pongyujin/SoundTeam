<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

	<properties resource="com/sound/database/db.properties"></properties>

	<settings>
		<setting name="mapUnderscoreToCamelCase" value="true" />

		<setting name="logImpl" value="STDOUT_LOGGING" />

		<setting name="logImpl" value="LOG4J" />

		<setting name="jdbcTypeForNull" value="NULL" />
	</settings>

	<environments default="development">
		<environment id="development">
			<transactionManager type="JDBC" />
			<dataSource type="POOLED">
				<property name="driver" value="${driver}" />
				<property name="url" value="${url}" />
				<property name="username" value="${username}" />
				<property name="password" value="${password}" />
			</dataSource>
		</environment>
	</environments>

	<mappers>
		<mapper resource="com/sound/DAO/UsersMapper.xml" />
		<mapper resource="com/sound/DAO/Ai_recommendationMapper.xml" />
		<mapper resource="com/sound/DAO/User_checkMapper.xml" />
		<mapper resource="com/sound/DAO/BoardMapper.xml" />
		<mapper resource="com/sound/DAO/ProductsMapper.xml" />
	</mappers>
</configuration>
