<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
	<display-name>Archetype Created Web Application</display-name>

	<servlet>
		<servlet-name>GoMyPage</servlet-name>
		<display-name>GoMyPage</display-name>
		<description></description>
		<servlet-class>com.sound.gopage.GoMyPage</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>GoInformation</servlet-name>
		<display-name>GoInformation</display-name>
		<description></description>
		<servlet-class>com.sound.gopage.GoInformation</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>SearchController</servlet-name>
		<display-name>SearchController</display-name>
			<description></description>
			<servlet-class>com.sound.controller.SearchController</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>GoSearchResultPage</servlet-name>
		<display-name>GoSearchResultPage</display-name>
		<description></description>
		<servlet-class>com.sound.gopage.GoSearchResultPage</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>SearchNaverApiController</servlet-name>
		<display-name>SearchNaverApiController</display-name>
		<description></description>
		<servlet-class>com.sound.controller.SearchNaverApiController</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>Test</servlet-name>
		<display-name>Test</display-name>
		<description></description>
		<servlet-class>com.sound.controller.Test</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>ApiTestServlet</servlet-name>
		<display-name>ApiTestServlet</display-name>
		<description></description>
		<servlet-class>com.sound.controller.ApiTestServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>GoMyPage</servlet-name>
		<url-pattern>/GoMyPage</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>GoInformation</servlet-name>
		<url-pattern>/GoInformation</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>SearchController</servlet-name>
		<url-pattern>/SearchController</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>GoSearchResultPage</servlet-name>
		<url-pattern>/GoSearchResultPage</url-pattern>
	</servlet-mapping>

	<!-- 하나의 매핑만 유지 -->
	<servlet-mapping>
		<servlet-name>SearchNaverApiController</servlet-name>
		<url-pattern>/SearchNaverApiController</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>Test</servlet-name>
		<url-pattern>/Test</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>ApiTestServlet</servlet-name>
		<url-pattern>/ApiTestServlet</url-pattern>
	</servlet-mapping>

</web-app>
